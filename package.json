{
  "name": "crossexam-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"vite\" \"node server.js\"",
    "client": "vite",
    "server": "node server.js",
    "build": "vite build",
    "build:desktop": "cross-env VITE_BASE=./ vite build --outDir dist-desktop",
    "electron:dev": "npm run build:desktop && cross-env STATIC_DIR=dist-desktop electron .",
    "dist:desktop": "npm run build:desktop && electron-builder --windows --publish never",
    "deploy": "vite build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@google/genai": "^1.0.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.11.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.460.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "space.sanky.datapirates",
    "productName": "Data Pirates",
    "artifactName": "Data-Pirates-Setup.exe",
    "asar": false,
    "files": [
      "electron/**",
      "server.js",
      "preprocessor.js",
      "dist-desktop/**",
      "node_modules/**",
      ".env"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  }
}
